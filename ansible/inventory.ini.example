# Example only. Generate the real inventory from the current Terraform state:
#   python3 generate_inventory.py

[bastions]
bastion ansible_host=BASTION_PUBLIC_IP

[control_plane]
control-plane ansible_host=CONTROL_PLANE_PRIVATE_IP

[public_workers]
public-worker ansible_host=PUBLIC_WORKER_PRIVATE_IP

[private_workers]
worker-1 ansible_host=WORKER_1_PRIVATE_IP
worker-2 ansible_host=WORKER_2_PRIVATE_IP

[db_workers]
db-worker ansible_host=DB_WORKER_PRIVATE_IP

[workers:children]
public_workers
private_workers
db_workers

[k8s:children]
control_plane
workers

[k8s:vars]
ansible_user=ec2-user
ansible_ssh_common_args='-o ProxyJump=ec2-user@BASTION_PUBLIC_IP'
